<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".StyleMatchApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StyleMatchIA">
        <activity
            android:name=".ui.screen.FavoritesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.crud.AdminHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.screen.RecomendacionesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.screen.AiAssistantActivity"
            android:exported="false" />
        <activity
            android:name=".ui.screen.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.screen.ProductDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.crud.InsertEditProductoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.crud.GestionRecomendacionesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.crud.CrudProductosActivity"
            android:exported="false" />
        <activity
            android:name=".ui.screen.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.StyleMatchIA">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
